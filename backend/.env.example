# ==================== База данных ====================
# По умолчанию — локальный SQLite. На проде — Supabase (Postgres, порт 6543, Connection Pooler).
DATABASE_URL=sqlite:///./nova.db

# ==================== Аутентификация ====================
SECRET_KEY=change-me

# ==================== Email (верификация, восстановление пароля) ====================
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=

# ==================== VK ====================
VK_APP_ID=
VK_SECRET_KEY=
VK_REDIRECT_URI=
VK_ACCESS_TOKEN=

# ==================== Lolka ====================
LOLKA_BOT_TOKEN=
LOLKA_CLIENT_ID=

# ==================== AI: форвард-комментарии (существующая функциональность) ====================
GEMINI_API_KEY=

# ==================== AI: LLM-провайдеры (ТЗ №9) ====================
# Провайдеры используются в LLMRouter (backend/ai_engine.py) с автопереключением при 429/403.
# Нужен минимум один ключ, но для полноценного failover рекомендуется настроить все три.
# GigaChat исключён из пула намеренно: требует отключения проверки TLS-сертификата
# (verify=False, сертификат НУЦ Минцифры не в системных доверенных корнях) — риск MITM
# и нестабильности на хостинге вне РФ.

# YandexGPT (Yandex Cloud) — API-ключ сервисного аккаунта + ID каталога (folder_id).
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=

# DeepSeek
DEEPSEEK_API_KEY=

# OpenRouter — используется и для чата (fallback-провайдер), и для эмбеддингов
# (семантический кэш, backend/ai_engine.py::get_embedding, модель openai/text-embedding-3-small).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Дневной лимит запросов к LLM для виджета "Лимиты API" на /dashboard/ai.
AI_DAILY_LIMIT=200

# ==================== MAX (мессенджер) ====================
# Третья платформа бота (backend/max_gateway.py). Область функционала сейчас — только
# AI-ассистент (диалог + модерация); вебхуки/репостинг событий — в планах.
# Один бот-токен на всё приложение (как у Lolka) — конкретные чаты добавляются
# на странице /dashboard/servers по их chat_id.
MAX_BOT_TOKEN=
# Публичный HTTPS-URL этого backend'а + /api/max/webhook — для регистрации подписки при
# старте (см. max_gateway.register_webhook). Пример: https://nova-bot-1-1hsz.onrender.com/api/max/webhook
MAX_WEBHOOK_URL=
# Проверяется в заголовке X-Max-Bot-Api-Secret входящих запросов — защита от подмены отправителя.
MAX_WEBHOOK_SECRET=
